<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox alignment="CENTER" spacing="10.0" stylesheets="@Principal.fxml" styleClass="root"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Proyecto">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Compra en Cafeteria" styleClass="title"/>

    <VBox spacing="10.0">
        <Label text="Cliente:" styleClass="field-title"/>
        <TextField fx:id="clienteTextField" onKeyPressed="#handleKeyPress" promptText="Ingrese el nombre del cliente"/>
    </VBox>

    <VBox spacing="10.0">
        <Label text="Bebida Disponible:" styleClass="field-title"/>
        <ComboBox fx:id="bebida" promptText="Seleccione una bebida">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Cafe Americano - RD$100"/>
                    <String fx:value="Cappuccino - RD$150"/>
                    <String fx:value="Chocolate Caliente - RD$120"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>

    <VBox spacing="10.0">
        <Label text="Cantidad:" styleClass="field-title"/>
        <TextField fx:id="cantidadTextField" promptText="Ingrese la cantidad de bebidas" onKeyPressed="#handleKeyPress"/>
    </VBox>

    <VBox spacing="10.0" alignment="CENTER_LEFT">
        <CheckBox fx:id="postreCheckBox" text="Agregar Postre" onAction="#handlePostreCheckBox"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="txtCalcular" text="Calcular" onAction="#handleCalcular" 
                onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited" styleClass="boton-primario"/>
        <Button fx:id="txtLimpiar" text="Limpiar" onAction="#handleLimpiar" styleClass="boton-secundario"/>
    </HBox>

    <VBox spacing="10.0" alignment="CENTER">
        <Label fx:id="Resultado" text="Resumen:" styleClass="Result-title"/>
        <Label fx:id="Estado" text="Estado" styleClass="Resultado"/>
    </VBox>

</VBox>

